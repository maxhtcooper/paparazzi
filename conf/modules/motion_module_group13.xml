<!DOCTYPE module SYSTEM "module.dtd">

<module name="motion_module_group13">
  <doc>
    <description>
This module provides simple SVM-driven obstacle reaction for the AE4317 course setup.
If the SVM module reports an obstacle, the vehicle turns by a fixed heading increment.
If no obstacle is detected, it keeps flying straight by pushing the goal waypoint forward.
    </description>
  </doc>
  <settings>
    <dl_settings>
      <dl_settings name="SvmAvoider">
         <dl_setting var="heading_increment" min="-45" step="1" max="45"/>
         <dl_setting var="forward_distance" min="0.2" step="0.1" max="3.0"/>
      </dl_settings>
    </dl_settings>
  </settings>
  
  <dep>
    <depends>svm</depends>
  </dep>
  <header>
    <file name="motion_module_group13.h"/>
  </header>
  <init fun="motion_module_group13_init()"/>
  <periodic fun="motion_module_group13_periodic()" freq="4"/>
  <makefile target="ap|nps">
    <file name="motion_module_group13.c"/>
  </makefile>
</module>
