<!DOCTYPE module SYSTEM "module.dtd">
<module name="of_avoidance">
  <doc>
    <description>Optical Flow Obstacle Avoidance</description>
  </doc>
  
  <settings>
    <dl_settings name="OfAvoidance"> <dl_setting var="avoidance_divergence_threshold" min="0.1" step="0.1" max="5.0" shortname="Div_Thresh"/> <dl_setting var="avoidance_speed" min="-2.0" step="0.1" max="0.0" shortname="Avoid_Speed"/>
    </dl_settings>
  </settings>

  <header>
    <file name="of_avoidance.h"/> </header>
  
  <init fun="of_avoidance_init()"/> <makefile>
    <file name="of_avoidance.c"/> </makefile>
</module>