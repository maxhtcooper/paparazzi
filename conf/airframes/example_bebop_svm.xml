<!--
  Example Paparazzi Airframe Configuration for Bebop with SVM Obstacle Detection
  
  This file demonstrates how to configure a Bebop drone with the SVM obstacle
  detection module enabled. Adapt the aircraft ID, coordinates, and settings
  to match your setup.
-->

<?xml version="1.0" encoding="UTF-8"?>
<airframe name="Bebop_SVM_Test" type="rotorcraft">

  <description>
    Parrot Bebop 2 with SVM optical flow-based obstacle detection.
    Detects obstacles in the middle third of the camera image.
    Optimized for Bebop's limited hardware (120x80 processing resolution).
  </description>

  <firmware name="rotorcraft">
    <target name="ap" 
            board="bebop"
            abi="telemetry"/>
  </firmware>

  <!-- ============== MODULES ============== -->
  <modules>
    <!-- Core flight systems -->
    <module name="telemetry" type="transparent_udp"/>
    <module name="imu" type="bebop"/>
    <module name="ahrs" type="int_cmpl_quat"/>
    <module name="ins" type="extended"/>
    <module name="air_data"/>
    <module name="gps" type="sim"/>
    
    <!-- Control systems -->
    <module name="motor_mixing"/>
    <module name="stabilization" type="indi"/>
    <module name="guidance" type="indi"/>
    
    <!-- Vision module - OBSTACLE DETECTION -->
    <module name="video_thread"/>
    <module name="video_capture"/>
    <!-- Enable SVM obstacle detection -->
    <module name="svm" dir="computer_vision"/>
    
    <!-- Monitoring -->
    <module name="system_monitor"/>
  </modules>

  <!-- ============== SERVOS ============== -->
  <servos driver="bebop">
    <!-- No traditional servos on Bebop, motor control only -->
  </servos>

  <!-- ============== COMMANDS ============== -->
  <commands>
    <axis name="ROLL"     failsafe_value="0"/>
    <axis name="PITCH"    failsafe_value="0"/>
    <axis name="YAW"      failsafe_value="0"/>
    <axis name="THRUST"   failsafe_value="0"/>
  </commands>

  <!-- ============== CAMERA ============== -->
  <section name="CAMERA" prefix="CAMERA_">
    <!-- Bebop front camera parameters -->
    <define name="INTRINSICS_FX" value="548.54"/>
    <define name="INTRINSICS_FY" value="548.54"/>
    <define name="INTRINSICS_CX" value="320.0"/>
    <define name="INTRINSICS_CY" value="240.0"/>
  </section>

  <!-- ============== IMU TUNING ============== -->
  <section name="IMU" prefix="IMU_">
    <define name="ACCEL_X_NEUTRAL" value="0"/>
    <define name="ACCEL_Y_NEUTRAL" value="0"/>
    <define name="ACCEL_Z_NEUTRAL" value="0"/>
    <define name="GYRO_X_NEUTRAL" value="0"/>
    <define name="GYRO_Y_NEUTRAL" value="0"/>
    <define name="GYRO_Z_NEUTRAL" value="0"/>
  </section>

  <!-- ============== AHRS TUNING ============== -->
  <section name="AHRS" prefix="AHRS_">
    <define name="H_X" value="0.3892"/>
    <define name="H_Y" value="0.0017"/>
    <define name="H_Z" value="0.9211"/>
  </section>

  <!-- ============== STABILIZATION ============== -->
  <section name="STABILIZATION_INDI" prefix="STABILIZATION_INDI_">
    <!-- Roll control -->
    <define name="REF_ERR_P" value="400"/>
    <define name="REF_RATE_P" value="28"/>
    <define name="FF_P" value="90"/>
    <define name="FILT_CUTOFF_P" value="8"/>
    
    <!-- Pitch control -->
    <define name="REF_ERR_Q" value="400"/>
    <define name="REF_RATE_Q" value="28"/>
    <define name="FF_Q" value="90"/>
    <define name="FILT_CUTOFF_Q" value="8"/>
    
    <!-- Yaw control -->
    <define name="REF_ERR_R" value="200"/>
    <define name="REF_RATE_R" value="14"/>
    <define name="FF_R" value="120"/>
    <define name="FILT_CUTOFF_R" value="4"/>
    
    <!-- Vertical control -->
    <define name="REF_ERR_Z" value="210"/>
    <define name="REF_RATE_ZD" value="14"/>
    <define name="FF_ZD" value="100"/>
    <define name="FILT_CUTOFF_Z" value="4"/>
  </section>

  <!-- ============== GUIDANCE ============== -->
  <section name="GUIDANCE_V" prefix="GUIDANCE_V_">
    <define name="HOVER_KP"   value="283"/>
    <define name="HOVER_KI"   value="85"/>
    <define name="HOVER_KD"   value="82"/>
    <define name="HOVER_KFF"  value="0"/>
    <define name="RC_CLIMB_COEF" value="163"/>
    <define name="RC_CLIMB_FILT" value="0.25"/>
  </section>

  <!-- ============== BATTERY ============== -->
  <section name="BATTERY" prefix="BATTERY_">
    <define name="MILLIAMP_AT_FULL_THROTTLE" value="2500"/>
    <define name="CAPACITY" value="2200"/>
    <define name="DANGEROUS" value="3.0" unit="V"/>
    <define name="CRITIC" value="3.1" unit="V"/>
    <define name="LOW" value="3.3" unit="V"/>
  </section>

  <!-- ============== FAILSAFE ============== -->
  <section name="FAILSAFE" prefix="FAILSAFE_">
    <define name="DELAY_WITHOUT_GPS" value="2" unit="s"/>
    <define name="DEFAULT_THROTTLE" value="0.9"/>
    <define name="DEFAULT_ROLL" value="0.1"/>
    <define name="DEFAULT_PITCH" value="0.0"/>
    <define name="HOME_RADIUS" value="100" unit="m"/>
  </section>

  <!-- ============== TELEMETRY ============== -->
  <section name="TELEMETRY" prefix="TELEMETRY_">
    <define name="INITIAL_LOGGING" value="0"/>
  </section>

</airframe>

<!-- ============================================================ 
     USING THIS CONFIGURATION WITH SVM OBSTACLE DETECTION
     ============================================================

FLIGHT PLAN INTEGRATION:

In your flight_plan.h or XML flight plan, include the SVM header:

  #include "modules/computer_vision/svm.h"
  
Then use obstacle_detected in your navigation logic:

  // Simple avoidance example:
  if (obstacle_detected) {
    // Detected obstacle - navigate to safe waypoint
    NavSetWaypoint(WP_SAFE);
  } else {
    // No obstacle - proceed normally
    NavSetWaypoint(WP_TARGET);
  }

MONITORING IN GCS:

The SVM module will output:
  - obstacle_detected: Binary detection result (0 or 1)
  - Available for logging and real-time monitoring

PERFORMANCE:

On Bebop 2:
  - Processing: ~15 ms per frame
  - CPU usage: ~30% (dual-core)
  - Frame rate: 40+ FPS achievable
  - Detection range: 1-3 meters (depending on speed)
  
TUNING:

If obstacle detection is not working as expected:
  1. Verify optical flow quality (check GCS logs)
  2. Adjust SVM threshold in svm.cpp (see SVM_BEBOP_GUIDE.md)
  3. Test with controlled obstacles first
  4. Log decision values for analysis

SAFETY:

Always use with RC pilot standing by and ready to take control.
Test extensively in controlled environments before autonomous flights.

============================================================ -->
